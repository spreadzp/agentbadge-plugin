{
    "name": "agentbadge/agentbadge-wp",
    "description": "AgentBadge — Agent Readiness scanner for WordPress (free local checks + optional Cloud verification)",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.0",
        "phpstan/phpstan": "^1.12",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "php-stubs/wordpress-stubs": "^6.5",
        "friendsofphp/php-cs-fixer": "^3.50",
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "vendor/bin/phpcs --standard=.phpcs.xml.dist",
        "lint:fix": "vendor/bin/php-cs-fixer fix",
        "stan": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test": "vendor/bin/phpunit",
        "check": [
            "@test",
            "@lint",
            "@stan"
        ]
    }
}
