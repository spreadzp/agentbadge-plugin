<?xml version="1.0"?>
<ruleset name="AGENTBADGE">
    <description>AgentBadge Coding Standards</description>

    <file>agentbadge.php</file>
    <file>includes</file>
    <file>templates</file>

    <!-- WordPress coding standards -->
    <rule ref="WordPress-Extra">
        <!-- Allow short array syntax [] -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax.Found"/>
        <!-- Allow table name interpolation in $wpdb->prepare() — table names are internal, not user input -->
        <exclude name="WordPress.DB.PreparedSQL.InterpolatedNotPrepared"/>
    </rule>
    <rule ref="WordPress-Docs"/>

    <!-- PHP version compatibility -->
    <config name="testVersion" value="8.1-"/>

    <!-- WordPress version -->
    <config name="minimum_supported_wp_version" value="6.4"/>

    <!-- Text domain -->
    <config name="text_domain" value="agentbadge"/>

    <!-- Prefixes -->
    <config name="prefixes" value="agentbadge_,Agentbadge_,AGENTBADGE_"/>

    <!-- Custom capabilities -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="agentbadge_view"/>
                <element value="agentbadge_scan"/>
                <element value="agentbadge_apply_fix"/>
                <element value="agentbadge_manage_consent"/>
                <element value="agentbadge_manage"/>
            </property>
        </properties>
    </rule>

    <!-- Templates legitimately define local vars in template scope — not globals -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
        <exclude-pattern>*/templates/*</exclude-pattern>
    </rule>

    <!-- Exclude patterns -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*/creds/*</exclude-pattern>
</ruleset>
